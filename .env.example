# ---------------------------------------------------------------------------
# AI Customer Complaint & Case Processing System - environment configuration
# Copy to .env (`cp .env.example .env`) and fill in real values.
# .env is git-ignored; never commit real API keys.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# One of: openai | gemini | ollama   (default: openai)
LLM_PROVIDER=openai

# Model name. Leave empty to use the provider default:
#   openai -> gpt-4o-mini   gemini -> gemini-2.0-flash   ollama -> llama3.1
MODEL_NAME=

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here

# Required only when LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key-here

# Used only when LLM_PROVIDER=ollama (local models, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM behaviour ----------------------------------------------------------
# Low temperature = more deterministic, factual output (default: 0.1)
LLM_TEMPERATURE=0.1
# Per-request timeout in seconds (default: 120)
LLM_TIMEOUT_SECONDS=120
# Provider-level retries for transient API errors (OpenAI/Gemini; default: 2)
LLM_MAX_RETRIES=2

# --- Paths (relative to the project root) -----------------------------------
# Folder with input complaint documents (.pdf / .txt / .docx)   (default: data)
DATA_DIR=data
# Folder for generated outputs   (default: output)
OUTPUT_DIR=output

# --- Processing -------------------------------------------------------------
# Number of documents processed in parallel (>= 1; default: 3)
MAX_WORKERS=3
# Document text is truncated to this many characters before prompting (default: 12000)
MAX_DOCUMENT_CHARS=12000

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR   (default: INFO). Logs go to console and logs/app.log
LOG_LEVEL=INFO
